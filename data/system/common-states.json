{
  "notes": "States every character has. 'free' = the player can act. 'loop' = repeats until something changes it. 'stun' = lasts as long as the fighter's stun counter (hitstun, blockstun). Characters override any of these. throwVictim: the engine applies the pending throw when this state ends. Durations, timeline frames (at, from, to, for) and cancel windows can name a stat with @. tumble = the untechable time is over: any button air-techs (airTech).",
  "states": {
    "idle": {"stance": "stand", "free": true, "loop": true, "duration": 60},
    "crouch": {"stance": "crouch", "free": true, "loop": true, "duration": 60},
    "walkF": {"stance": "stand", "free": true, "loop": true, "duration": 60, "timeline": [{"at": 0, "vel": {"x": "@walkForward"}}]},
    "walkB": {"stance": "stand", "free": true, "loop": true, "duration": 60, "timeline": [{"at": 0, "vel": {"x": "-@walkBack"}}]},
    "jumpSquat": {"stance": "stand", "duration": "@prejump", "next": "jump", "keepVel": true},
    "jump": {"stance": "air", "free": true, "loop": true, "loopFrom": 1, "duration": 60, "timeline": [{"at": 0, "jump": "normal"}]},
    "fall": {"stance": "air", "free": true, "loop": true, "duration": 60},
    "land": {"stance": "stand", "duration": "@landing", "next": "idle"},
    "dashF": {"stance": "stand", "duration": "@dashFrames", "next": "dashStop", "timeline": [{"at": 0, "vel": {"x": "@dashSpeed"}}], "cancels": [{"from": "@dashCancel", "into": ["#normal", "#special", "#super", "#jump"], "on": ["whiff", "hit", "block"]}]},
    "dashStop": {"stance": "stand", "duration": "@dashRecovery", "next": "idle"},
    "backdash": {"stance": "stand", "duration": "@backdashFrames", "next": "backdashStop", "timeline": [{"at": 0, "vel": {"x": "-@backdashSpeed"}},{"from": 0, "for": "@backdashInvuln", "invuln": {"strike": true, "throw": true}}]},
    "backdashStop": {"stance": "stand", "duration": "@backdashRecovery", "next": "idle"},
    "airdashF": {"stance": "air", "duration": "@airdashFrames", "next": "airdashEnd", "timeline": [{"at": 0, "vel": {"x": "@airdashSpeed", "y": 0}, "gravity": false}], "cancels": [{"from": "@airdashCancel", "into": ["#normal", "#special", "#super"], "on": ["whiff", "hit", "block"]}]},
    "airdashB": {"stance": "air", "duration": "@airdashBackFrames", "next": "airdashEnd", "timeline": [{"at": 0, "vel": {"x": "-@airdashBackSpeed", "y": 0}, "gravity": false}], "cancels": [{"from": "@airdashCancel", "into": ["#normal", "#special", "#super"], "on": ["whiff", "hit", "block"]}]},
    "airdashEnd": {"stance": "air", "free": true, "loop": true, "loopFrom": 1, "duration": 60, "timeline": [{"at": 0, "velScale": {"x": "@airdashKeep"}}]},
    "superJumpSquat": {"stance": "stand", "duration": "@prejump", "next": "superJump", "keepVel": true},
    "superJump": {"stance": "air", "free": true, "loop": true, "loopFrom": 1, "duration": 60, "timeline": [{"at": 0, "jump": "super"}]},
    "airJump": {"stance": "air", "free": true, "loop": true, "loopFrom": 1, "duration": 60, "timeline": [{"at": 0, "jump": "air"}]},
    "hitStand": {"stance": "stand", "stun": true, "next": "idle"},
    "hitCrouch": {"stance": "crouch", "stun": true, "next": "crouch"},
    "hitAir": {"stance": "air", "stun": true, "next": "tumble", "keepVel": true, "landTo": "knockdown"},
    "tumble": {"stance": "air", "loop": true, "duration": 60, "techable": true, "landTo": "knockdown"},
    "airTech": {"stance": "air", "duration": "@airTech", "next": "fall", "timeline": [{"at": 0, "vel": {"x": -2, "y": 5}}, {"from": 0, "for": "@airTechInvuln", "invuln": {"strike": true, "throw": true}}]},
    "blockStand": {"stance": "stand", "stun": true, "next": "idle"},
    "blockCrouch": {"stance": "crouch", "stun": true, "next": "crouch"},
    "blockAir": {"stance": "air", "stun": true, "next": "fall", "keepVel": true},
    "knockdown": {"stance": "crouch", "duration": 40, "next": "wakeup", "timeline": [{"at": 0, "hurt": [], "invuln": {"strike": true, "throw": true}}]},
    "wakeup": {"stance": "stand", "duration": 12, "next": "idle", "timeline": [{"at": 0, "invuln": {"strike": true, "throw": true}}]},
    "thrown": {"stance": "stand", "stun": true, "next": "knockdown", "throwVictim": true, "timeline": [{"at": 0, "hurt": [], "invuln": {"strike": true, "throw": true}}]},
    "throwHold": {"stance": "stand", "stun": true, "next": "throwFinish", "timeline": [{"at": 0, "invuln": {"strike": true, "throw": true}}]},
    "throwFinish": {"stance": "stand", "duration": 18, "next": "idle"},
    "koDown": { "stance": "crouch", "loop": true, "duration": 60, "timeline": [{ "at": 0, "hurt": [], "invuln": { "strike": true, "throw": true } }] },
    "throwTech": {"stance": "stand", "stun": true, "next": "idle"}
  }
}
